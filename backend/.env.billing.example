# Copy fields into the server environment only. All paid services start disabled.
BILLING_MODELS_JSON=[]
BILLING_PROVIDER_KEYS_JSON={}
# Each model requires id/provider/displayName/model/baseUrl, explicit
# inputPricePerMillionYuan/outputPricePerMillionYuan decimal strings, and
# maxInputTokens/maxOutputTokens positive integers. baseUrl is the full HTTPS
# OpenAI-compatible /chat/completions endpoint. Keys map provider IDs to secrets.
# No suppliers, production prices, credentials or budgets are guessed here.
BILLING_PAYMENTS_ENABLED=false
# Platform credits reuse BILLING_PROVIDER_KEYS_JSON["deepseek"]; the switch alone
# is not enough. Purchases, renewal and refunds are not implemented.
CREDITS_DEEPSEEK_ENABLED=false
BILLING_NOTIFY_BASE_URL=
BILLING_ALIPAY_APP_ID=
BILLING_ALIPAY_SELLER_ID=
BILLING_ALIPAY_PRIVATE_KEY_PEM=
BILLING_ALIPAY_PUBLIC_KEY_PEM=
BILLING_WECHAT_APP_ID=
BILLING_WECHAT_MCHID=
BILLING_WECHAT_SERIAL=
BILLING_WECHAT_PRIVATE_KEY_PEM=
BILLING_WECHAT_PUBLIC_KEY_PEM=
BILLING_WECHAT_PUBLIC_SERIAL=
BILLING_WECHAT_API_V3_KEY=
