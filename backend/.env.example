# 复制为 .env 后填写。.env 已被 .gitignore 忽略，切勿提交真实密钥。

# SQLAlchemy 连接串。开发可用 SQLite：
DATABASE_URL=sqlite:///./studypilot.db
# 或 MySQL：
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/studypilot?charset=utf8mb4

# 数据库密码（MySQL 部署时填写，SQLite 可留空）
DB_PASSWORD=

# AES-256-GCM 密钥，用于加密存储用户提交的 AI API Key。
# 必须是 base64 编码的 32 字节，生成方式：
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
AES_KEY=

# 会话有效期（分钟）
SESSION_TIMEOUT_MINUTES=30
