# ---- Python / 后端 ----
backend/.env
backend/.venv/
**/__pycache__/
*.py[cod]
backend/*.db*
backend/.sessions.json
backend/.sessions.json.tmp
backend/_latest_plan.txt
backend/scripts/_*.py
# 一次性验证脚本与产物：会话令牌、接口原始输出、临时抓取目录，一律不进仓库
backend/.verify_token
backend/_verify*.py
backend/_verify*.txt
backend/_verify*_raw/
backend/_v13*.py
backend/_v13*.json
backend/_v13*.txt
backend/_v13*_raw/
# 根目录一次性脚本与产物：以 _ 开头、处理数据文件用，不进仓库
# 用通用前缀而不是 _courses_*：换一批数据就会换前缀，逐个列会再漏一次
/_*.py
/_*.json
/_*.txt
/_*.diff
.tmp-course/
**/.pytest_cache/
**/.hypothesis/

# ---- Node / 前端 ----
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
*.log

# ---- 本地语音环境（venv 与 pip 缓存，不进仓库）----
speech/.venv/
speech/.cache/

# ---- 编辑器 / 系统 ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
